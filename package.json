{
  "name": "remind-rest",
  "version": "1.0.0",
  "productName": "restTime",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "packageMac": "npm run build && npx @electron/packager@20.3.0 . --overwrite",
    "buildMac": "npm run build && npx electron-builder --mac --arm64",
    "build": "vite build && tsc && cp main/store.json dist/main/store.json && cp -R icon dist/"
  },
  "build": {
    "appId": "rest.time.lay4519",
    "productName": "Lay",
    "files": [
      "node_modules/",
      "dist/",
      "package.json"
    ],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "gsap": "^3.3.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^42.11.16",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "packageManager": "npm@11.20.0"
}
